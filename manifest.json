{
  "manifest_version": 3,
  "name": "FileChute",
  "short_name": "FileChute",
  "version": "0.1.35",
  "description": "Browse user-selected local files from a persistent browser side panel and drag the originals where you need them.",
  "homepage_url": "https://github.com/thanks-cohn/filechute",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Toggle FileChute",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker-bootstrap.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-drop-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-image-drag-source.js", "page-resource-export.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.google.com/*"],
      "js": ["google-image-drag-source.js", "page-resource-export.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.yandex.com/*",
        "https://*.yandex.ru/*",
        "https://*.yandex.kz/*",
        "https://*.yandex.by/*",
        "https://*.yandex.uz/*",
        "https://*.yandex.com.tr/*"
      ],
      "js": ["yandex-image-drag-source.js", "page-resource-export.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "pagination.css",
        "settings-media.css",
        "sidepanel.js",
        "shelf-live-refresh.js",
        "single-destination-drop.js",
        "ui-enhancements.js",
        "directory-visibility.js",
        "drop-feedback.js",
        "incoming-drop-upgrade.js",
        "browser-drag-normalizer.js",
        "chatgpt-image-drop-fallback.js",
        "google-image-drop-fallback.js",
        "yandex-image-drop-fallback.js",
        "directory-drag.js",
        "settings-draft.js",
        "durable-storage-settings.js",
        "image-resize.js",
        "image-resize-v2.js",
        "image-resize-v3.js",
        "resize-usability-patch.js",
        "chute-drop-compat.js",
        "receive-drops.js",
        "folder-picker.js",
        "first-run.js",
        "storage.js",
        "interop.js",
        "metadata-store.js",
        "thumbnail-store.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
