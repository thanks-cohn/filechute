{
  "manifest_version": 3,
  "name": "FileChute",
  "version": "0.1.16",
  "description": "Browse user-selected local files from a persistent browser side panel and drag the originals where you need them.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "optional_host_permissions": [
    "http://127.0.0.1:17891/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Toggle FileChute"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["page-drop-bridge.js", "page-resource-export.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.google.com/*"],
      "js": ["google-image-drag-source.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "pagination.css",
        "settings-media.css",
        "sidepanel.js",
        "ui-enhancements.js",
        "directory-visibility.js",
        "incoming-drop-upgrade.js",
        "browser-drag-normalizer.js",
        "google-image-drop-fallback.js",
        "directory-drag.js",
        "settings-draft.js",
        "chute-drop-compat.js",
        "receive-drops.js",
        "folder-picker.js",
        "first-run.js",
        "storage.js",
        "interop.js",
        "metadata-store.js",
        "thumbnail-store.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
