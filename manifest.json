{
  "manifest_version": 3,
  "name": "Chute",
  "short_name": "Chute",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "A local-first filesystem shelf with Chutty-assisted image capture.",
  "permissions": ["storage", "sidePanel"],
  "icons": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "action": { "default_title": "Open Chute", "default_icon": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["chatgpt-image-drag-source.js", "chutty.js"], "run_at": "document_start" },
    { "matches": ["https://*.google.com/*"], "js": ["google-image-drag-source.js", "chutty.js"], "run_at": "document_start" },
    { "matches": ["https://*.yandex.com/*", "https://*.yandex.ru/*", "https://*.yandex.kz/*", "https://*.yandex.by/*", "https://*.yandex.uz/*", "https://*.yandex.com.tr/*"], "js": ["yandex-image-drag-source.js", "chutty.js"], "run_at": "document_start" }
  ]
}
