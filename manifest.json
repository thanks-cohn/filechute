{
  "manifest_version": 3,
  "name": "FileChute",
  "version": "0.1.0",
  "description": "Browse user-selected local files beside Chromium and drag the originals where you need them.",
  "permissions": ["sidePanel", "storage"],
  "optional_host_permissions": ["http://127.0.0.1:17891/*"],
  "action": {
    "default_title": "Open FileChute"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
